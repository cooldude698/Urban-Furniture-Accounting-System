/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                      Int               @id @default(autoincrement())
  login_id                String            @unique
  email                   String            @unique
  full_name               String
  password_hash           String?
  role                    String
  contact_id              Int?
  invite_token            String?           @unique
  invite_token_expires_at DateTime?         @db.Timestamptz(6)
  created_at              DateTime          @default(now()) @db.Timestamptz(6)
  audit_log               audit_log[]
  budgets                 budgets[]
  journal_entries         journal_entries[]
  contacts                contacts?         @relation(fields: [contact_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model vendor_bill_lines {
  id                  Int                @id @default(autoincrement())
  bill_id             Int
  line_no             Int
  product_id          Int
  account_id          Int
  analytic_account_id Int?
  qty                 Decimal            @db.Decimal(12, 2)
  unit_price          Decimal            @db.Decimal(14, 2)
  tax_rate            Decimal            @default(0) @db.Decimal(5, 2)
  subtotal            Decimal            @db.Decimal(14, 2)
  tax_amount          Decimal            @default(0) @db.Decimal(14, 2)
  total               Decimal            @db.Decimal(14, 2)
  accounts            accounts           @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  analytic_accounts   analytic_accounts? @relation(fields: [analytic_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendor_bills        vendor_bills       @relation(fields: [bill_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products            products           @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model vendor_bills {
  id                  Int                   @id @default(autoincrement())
  number              String                @unique
  bill_reference      String?
  po_id               Int?
  vendor_id           Int
  bill_date           DateTime              @default(dbgenerated("CURRENT_DATE")) @db.Date
  due_date            DateTime?             @db.Date
  status              String                @default("draft")
  subtotal            Decimal               @default(0) @db.Decimal(14, 2)
  tax_total           Decimal               @default(0) @db.Decimal(14, 2)
  total               Decimal               @default(0) @db.Decimal(14, 2)
  journal_entry_id    Int?
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  payment_allocations payment_allocations[]
  vendor_bill_lines   vendor_bill_lines[]
  journal_entries     journal_entries?      @relation(fields: [journal_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchase_orders     purchase_orders?      @relation(fields: [po_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contacts            contacts              @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
