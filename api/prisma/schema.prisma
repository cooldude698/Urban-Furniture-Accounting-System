  order_date        DateTime            @default(dbgenerated("CURRENT_DATE")) @db.Date
  status            String              @default("draft")
  subtotal          Decimal             @default(0) @db.Decimal(14, 2)
  tax_total         Decimal             @default(0) @db.Decimal(14, 2)
  total             Decimal             @default(0) @db.Decimal(14, 2)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  customer_invoices customer_invoices[]
  sales_order_lines sales_order_lines[]
  contacts          contacts            @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model stock_moves {
  id          Int      @id @default(autoincrement())
  product_id  Int
  qty_change  Decimal  @db.Decimal(12, 2)
  move_date   DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  source_type String
  source_id   Int
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  products    products @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
