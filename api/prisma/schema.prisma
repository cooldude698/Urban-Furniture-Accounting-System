generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model accounts {
  id                     Int                      @id @default(autoincrement())
  name                   String
  type                   String
  is_archived            Boolean                  @default(false)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  customer_invoice_lines customer_invoice_lines[]
  journal_entry_lines    journal_entry_lines[]
  journals               journals[]
  vendor_bill_lines      vendor_bill_lines[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model analytic_accounts {
  id                     Int                      @id @default(autoincrement())
  name                   String
  type                   String
  is_archived            Boolean                  @default(false)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  budget_lines           budget_lines[]
  customer_invoice_lines customer_invoice_lines[]
  journal_entry_lines    journal_entry_lines[]
  purchase_order_lines   purchase_order_lines[]
  sales_order_lines      sales_order_lines[]
  vendor_bill_lines      vendor_bill_lines[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model audit_log {
  id          Int      @id @default(autoincrement())
  table_name  String
  record_id   Int
  action      String
  user_id     Int?
  before_data Json?
  after_data  Json?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users?   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model budget_lines {
  id                  Int               @id @default(autoincrement())
  budget_id           Int
  analytic_account_id Int
  committed_amount    Decimal           @db.Decimal(14, 2)
  analytic_accounts   analytic_accounts @relation(fields: [analytic_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  budgets             budgets           @relation(fields: [budget_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model budgets {
  id                  Int            @id @default(autoincrement())
  name                String
  period_start        DateTime       @db.Date
  period_end          DateTime       @db.Date
  responsible_user_id Int?
  status              String         @default("draft")
  revised_of_id       Int?
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  budget_lines        budget_lines[]
  users               users?         @relation(fields: [responsible_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  budgets             budgets?       @relation("budgetsTobudgets", fields: [revised_of_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_budgets       budgets[]      @relation("budgetsTobudgets")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model contacts {
  id                  Int                   @id @default(autoincrement())
  name                String
  type                String
  email               String?
  mobile              String?
  address             String?
  city                String?
  state               String?
  pincode             String?
  image_path          String?
  gstin               String?
  is_archived         Boolean               @default(false)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  customer_invoices   customer_invoices[]
  journal_entry_lines journal_entry_lines[]
  payments            payments[]
  purchase_orders     purchase_orders[]
  sales_orders        sales_orders[]
  users               users[]
  vendor_bills        vendor_bills[]
}

model customer_invoice_lines {
  id                  Int                @id @default(autoincrement())
  invoice_id          Int
  line_no             Int
  product_id          Int
  account_id          Int
  analytic_account_id Int?
  qty                 Decimal            @db.Decimal(12, 2)
  unit_price          Decimal            @db.Decimal(14, 2)
  tax_rate            Decimal            @default(0) @db.Decimal(5, 2)
  subtotal            Decimal            @db.Decimal(14, 2)
  tax_amount          Decimal            @default(0) @db.Decimal(14, 2)
  total               Decimal            @db.Decimal(14, 2)
  accounts            accounts           @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  analytic_accounts   analytic_accounts? @relation(fields: [analytic_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer_invoices   customer_invoices  @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products            products           @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model customer_invoices {
  id                     Int                      @id @default(autoincrement())
  number                 String                   @unique
  so_id                  Int?
  customer_id            Int
  invoice_date           DateTime                 @default(dbgenerated("CURRENT_DATE")) @db.Date
  due_date               DateTime?                @db.Date
  status                 String                   @default("draft")
  subtotal               Decimal                  @default(0) @db.Decimal(14, 2)
  tax_total              Decimal                  @default(0) @db.Decimal(14, 2)
  total                  Decimal                  @default(0) @db.Decimal(14, 2)
  journal_entry_id       Int?
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  customer_invoice_lines customer_invoice_lines[]
  contacts               contacts                 @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal_entries        journal_entries?         @relation(fields: [journal_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sales_orders           sales_orders?            @relation(fields: [so_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_allocations    payment_allocations[]
}

model doc_sequences {
  code           String  @id
  prefix         String
  use_year       Boolean @default(true)
  padding        Int     @default(4)
  current_number Int     @default(0)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model journal_entries {
  id                    Int                   @id @default(autoincrement())
  number                String                @unique
  journal_id            Int
  entry_date            DateTime              @default(dbgenerated("CURRENT_DATE")) @db.Date
  reference             String?
  status                String                @default("draft")
  source_type           String?
  source_id             Int?
  reversal_of           Int?
  created_by            Int?
  created_at            DateTime              @default(now()) @db.Timestamptz(6)
  customer_invoices     customer_invoices[]
  users                 users?                @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journals              journals              @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal_entries       journal_entries?      @relation("journal_entriesTojournal_entries", fields: [reversal_of], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_journal_entries journal_entries[]     @relation("journal_entriesTojournal_entries")
  journal_entry_lines   journal_entry_lines[]
  payments              payments[]
  vendor_bills          vendor_bills[]

  @@index([entry_date], map: "idx_je_entry_date")
  @@index([source_type, source_id], map: "idx_je_source")
  @@index([status], map: "idx_je_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model journal_entry_lines {
  id                  Int                @id @default(autoincrement())
  entry_id            Int
  account_id          Int
  partner_id          Int?
  analytic_account_id Int?
  debit               Decimal            @default(0) @db.Decimal(14, 2)
  credit              Decimal            @default(0) @db.Decimal(14, 2)
  description         String?
  accounts            accounts           @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  analytic_accounts   analytic_accounts? @relation(fields: [analytic_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal_entries     journal_entries    @relation(fields: [entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contacts            contacts?          @relation(fields: [partner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([account_id], map: "idx_jel_account_id")
  @@index([entry_id], map: "idx_jel_entry_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model journals {
  id                 Int               @id @default(autoincrement())
  name               String
  type               String
  default_account_id Int
  is_archived        Boolean           @default(false)
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  journal_entries    journal_entries[]
  accounts           accounts          @relation(fields: [default_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payment_allocations {
  id                Int                @id @default(autoincrement())
  payment_id        Int
  invoice_id        Int?
  bill_id           Int?
  amount            Decimal            @db.Decimal(14, 2)
  vendor_bills      vendor_bills?      @relation(fields: [bill_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer_invoices customer_invoices? @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments          payments           @relation(fields: [payment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id                  Int                   @id @default(autoincrement())
  number              String                @unique
  direction           String
  partner_id          Int
  method              String
  payment_date        DateTime              @default(dbgenerated("CURRENT_DATE")) @db.Date
  amount              Decimal               @db.Decimal(14, 2)
  journal_entry_id    Int?
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  payment_allocations payment_allocations[]
  journal_entries     journal_entries?      @relation(fields: [journal_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contacts            contacts              @relation(fields: [partner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id                     Int                      @id @default(autoincrement())
  sku                    String?                  @unique
  name                   String
  type                   String
  category               String?
  sales_price            Decimal                  @default(0) @db.Decimal(14, 2)
  cost_price             Decimal                  @default(0) @db.Decimal(14, 2)
  mrp                    Decimal?                 @db.Decimal(14, 2)
  tax_rate               Decimal                  @default(0) @db.Decimal(5, 2)
  stock_qty              Decimal                  @default(0) @db.Decimal(12, 2)
  is_archived            Boolean                  @default(false)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  customer_invoice_lines customer_invoice_lines[]
  purchase_order_lines   purchase_order_lines[]
  sales_order_lines      sales_order_lines[]
  stock_moves            stock_moves[]
  vendor_bill_lines      vendor_bill_lines[]
}

model purchase_order_lines {
  id                  Int                @id @default(autoincrement())
  po_id               Int
  line_no             Int
  product_id          Int
  analytic_account_id Int?
  qty                 Decimal            @db.Decimal(12, 2)
  unit_price          Decimal            @db.Decimal(14, 2)
  total               Decimal            @db.Decimal(14, 2)
  analytic_accounts   analytic_accounts? @relation(fields: [analytic_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchase_orders     purchase_orders    @relation(fields: [po_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products            products           @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model purchase_orders {
  id                   Int                    @id @default(autoincrement())
  number               String                 @unique
  vendor_id            Int
  order_date           DateTime               @default(dbgenerated("CURRENT_DATE")) @db.Date
  status               String                 @default("draft")
  total                Decimal                @default(0) @db.Decimal(14, 2)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  purchase_order_lines purchase_order_lines[]
  contacts             contacts               @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendor_bills         vendor_bills[]
}

model sales_order_lines {
  id                  Int                @id @default(autoincrement())
  so_id               Int
  line_no             Int
  product_id          Int
  analytic_account_id Int?
  qty                 Decimal            @db.Decimal(12, 2)
  unit_price          Decimal            @db.Decimal(14, 2)
  tax_rate            Decimal            @default(0) @db.Decimal(5, 2)
  subtotal            Decimal            @db.Decimal(14, 2)
  tax_amount          Decimal            @default(0) @db.Decimal(14, 2)
  total               Decimal            @db.Decimal(14, 2)
